<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <script>if(localStorage.getItem('byggr-cookies')){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=G-KTDQMECGQJ';document.head.appendChild(s);window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());gtag('config','G-KTDQMECGQJ');}</script>

  <meta name="description" content="{{ metaDescription }}">
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <title>{{ pageTitle }}</title>
  <link rel="canonical" href="{{ canonical }}">

  <meta property="og:title" content="{{ ogTitle if ogTitle else pageTitle }}">
  <meta property="og:description" content="{{ ogDescription if ogDescription else metaDescription }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:type" content="{{ ogType if ogType else 'website' }}">
  <meta property="og:locale" content="nl_NL">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle if ogTitle else pageTitle }}">
  <meta name="twitter:description" content="{{ ogDescription if ogDescription else metaDescription }}">
  <meta name="twitter:image" content="{{ ogImage }}">

  {% if structuredData %}
  <script type="application/ld+json">
  {{ structuredData | safe }}
  </script>
  {% endif %}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: #0a0b0d; }
    body {
      font-family: 'Archivo', system-ui, sans-serif;
      color: #ecece4;
      -webkit-font-smoothing: antialiased;
    }
    ::selection { background: rgba(79,168,255,.28); color: #fff; }
    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }

    /* ── Navigatie ──────────────────────────────────────────────── */
    .site-nav {
      position: fixed;
      top: 24px;
      left: 34px;
      z-index: 100;
      display: flex;
      align-items: center;
    }
    .site-nav__wordmark {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 34px;
      position: relative;
    }
    .site-nav__ring {
      position: absolute;
      left: 50%; top: 50%;
      transform: translate(-50%, -50%);
      width: 34px; height: 34px;
      border-radius: 50%;
      border: 1.5px solid rgba(79,168,255,.6);
      box-shadow: 0 0 18px rgba(79,168,255,.16);
      pointer-events: none;
    }
    .site-nav__name {
      position: relative;
      font-weight: 800;
      font-size: 19px;
      letter-spacing: .02em;
      color: #ecece4;
      line-height: 1;
    }

    /* ── Top-right nav links ─────────────────────────────────────── */
    .site-toplinks {
      position: fixed;
      top: 24px;
      right: 34px;
      z-index: 100;
      display: flex;
      gap: 28px;
      align-items: center;
    }
    .site-toplink {
      font-family: 'Space Mono', monospace;
      font-size: 11.5px;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: rgba(236,234,228,.55);
      text-decoration: none;
      transition: color .25s;
    }
    .site-toplink:hover { color: #ecece4; }

    /* ── Section label (kicker) ─────────────────────────────────── */
    .section-label {
      display: block;
      font-family: 'Space Mono', monospace;
      font-size: 12px;
      letter-spacing: .28em;
      text-transform: uppercase;
      color: #4fa8ff;
      margin-bottom: 16px;
    }

    /* ── Knoppen ────────────────────────────────────────────────── */
    .btn {
      display: inline-flex;
      align-items: center;
      font-weight: 600;
      font-size: 15px;
      letter-spacing: .01em;
      padding: 14px 28px;
      cursor: pointer;
      border: 1px solid transparent;
      transition: box-shadow .2s, color .2s, background .2s;
      font-family: 'Archivo', system-ui, sans-serif;
    }
    .btn--primary {
      color: #0a0b0d;
      background: #4fa8ff;
      box-shadow: 0 0 26px rgba(79,168,255,.35);
    }
    .btn--primary:hover { box-shadow: 0 0 40px rgba(79,168,255,.55); }
    .btn--outline {
      color: #ecece4;
      background: transparent;
      border-color: rgba(236,234,228,.28);
    }
    .btn--outline:hover { border-color: rgba(236,234,228,.6); }

    /* ── Reveal animaties (voor detail-pagina's) ────────────────── */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity .9s cubic-bezier(0.16,1,0.3,1), transform .9s cubic-bezier(0.16,1,0.3,1);
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-fade {
      opacity: 0;
      transition: opacity 1s cubic-bezier(0.16,1,0.3,1);
    }
    .reveal-fade.visible { opacity: 1; }
    .reveal-scale {
      opacity: 0;
      transform: scale(0.97);
      transition: opacity .9s cubic-bezier(0.16,1,0.3,1), transform .9s cubic-bezier(0.16,1,0.3,1);
    }
    .reveal-scale.visible { opacity: 1; transform: scale(1); }
    @media (prefers-reduced-motion: reduce) {
      .reveal, .reveal-fade, .reveal-scale { opacity: 1; transform: none; transition: none; }
    }

    /* ── Focus ──────────────────────────────────────────────────── */
    :focus-visible { outline: 2px solid #4fa8ff; outline-offset: 3px; }

    /* ── Footer ─────────────────────────────────────────────────── */
    .site-footer {
      border-top: 1px solid rgba(236,234,228,.08);
      padding: 28px 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    .site-footer__nav { display: flex; gap: 24px; }
    .site-footer__nav a {
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: rgba(236,234,228,.35);
      transition: color .2s;
    }
    .site-footer__nav a:hover { color: rgba(236,234,228,.75); }
    .site-footer__copy {
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      letter-spacing: .1em;
      color: rgba(236,234,228,.22);
      margin: 0;
    }

    /* ── Cookie banner ───────────────────────────────────────────── */
    .cookie-banner {
      position: fixed;
      bottom: 24px; left: 24px;
      max-width: 420px;
      background: #0c0e12;
      border: 1px solid rgba(236,234,228,.12);
      padding: 18px 20px;
      z-index: 9999;
      display: flex;
      gap: 16px;
      align-items: center;
    }
    .cookie-banner p { margin: 0; flex: 1; font-size: 13px; line-height: 1.5; color: rgba(236,234,228,.6); }
    .cookie-banner a { color: #4fa8ff; }
    .cookie-banner__btn { all: unset; cursor: pointer; font-weight: 600; font-size: 13px; color: #4fa8ff; white-space: nowrap; }
    .cookie-banner[hidden] { display: none !important; }
  </style>

  {% for css in extraCSS %}<link rel="stylesheet" href="{{ css }}">
  {% endfor %}

  {% if inlineCSS %}<style>{{ inlineCSS | safe }}</style>{% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

  <header class="site-nav" role="banner">
    <a href="/" class="site-nav__wordmark" aria-label="BYGGR — naar homepage">
      <span class="site-nav__ring" aria-hidden="true"></span>
      <span class="site-nav__name">BYGGR</span>
    </a>
  </header>
  <nav class="site-toplinks" aria-label="Hoofdnavigatie">
    <a href="/#cases" class="site-toplink">Cases</a>
    <a href="/#contact-form" class="site-toplink">Contact</a>
  </nav>

  <main id="main-content">
    {{ content | safe }}
  </main>

  <footer class="site-footer" role="contentinfo">
    <nav class="site-footer__nav" aria-label="Footer navigatie">
      <a href="/">Home</a>
      <a href="/privacy.html">Privacy</a>
    </nav>
    <p class="site-footer__copy">&copy; <span id="current-year">2026</span> BYGGR &mdash; Remco Baumeister, Delden</p>
  </footer>

  <div id="cookie-banner" class="cookie-banner" role="alertdialog" aria-label="Cookiemelding" hidden>
    <p>Deze site gebruikt analytics. <a href="/privacy.html">Meer info</a></p>
    <button id="cookie-accept" class="cookie-banner__btn">Akkoord</button>
  </div>

  {% if includeNetlifyIdentity %}
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on('init', function(user) {
        if (!user) {
          window.netlifyIdentity.on('login', function() { document.location.href = '/admin/'; });
        }
      });
    }
  </script>
  {% endif %}

  <script src="/src/js/animations.js" defer></script>
  <script>
    document.getElementById('current-year').textContent = new Date().getFullYear();
    (function () {
      function loadGA() {
        if (window._gaLoaded) return;
        window._gaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KTDQMECGQJ';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-KTDQMECGQJ');
      }
      if (localStorage.getItem('byggr-cookies')) {
        loadGA();
      } else {
        var banner = document.getElementById('cookie-banner');
        if (banner) banner.removeAttribute('hidden');
      }
      var btn = document.getElementById('cookie-accept');
      if (btn) btn.addEventListener('click', function () {
        localStorage.setItem('byggr-cookies', '1');
        var banner = document.getElementById('cookie-banner');
        if (banner) banner.setAttribute('hidden', '');
        loadGA();
      });
    })();
  </script>

</body>
</html>
