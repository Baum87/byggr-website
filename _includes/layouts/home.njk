<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <script>if(localStorage.getItem('byggr-cookies')){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=G-KTDQMECGQJ';document.head.appendChild(s);window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());gtag('config','G-KTDQMECGQJ');}</script>

  <meta name="description" content="{{ metaDescription }}">
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <title>{{ pageTitle }}</title>
  <link rel="canonical" href="{{ canonical }}">

  <meta property="og:title" content="{{ ogTitle if ogTitle else pageTitle }}">
  <meta property="og:description" content="{{ ogDescription if ogDescription else metaDescription }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:type" content="{{ ogType if ogType else 'website' }}">
  <meta property="og:locale" content="nl_NL">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle if ogTitle else pageTitle }}">
  <meta name="twitter:description" content="{{ ogDescription if ogDescription else metaDescription }}">
  <meta name="twitter:image" content="{{ ogImage }}">

  {% if structuredData %}
  <script type="application/ld+json">
  {{ structuredData | safe }}
  </script>
  {% endif %}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: #0a0b0d; }
    body { font-family: 'Archivo', system-ui, sans-serif; color: #ecece4; -webkit-font-smoothing: antialiased; }
    ::selection { background: rgba(79,168,255,.28); color: #fff; }
    a { color: inherit; text-decoration: none; }

    .byg-toplink {
      all: unset;
      cursor: pointer;
      font-family: 'Space Mono', monospace;
      font-size: 11.5px;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: rgba(236,234,228,.55);
      transition: color .25s;
    }
    .byg-toplink:hover { color: #ecece4; }

    /* ── Contact form section ───────────────────────────────────── */
    .contact-section {
      background: #0a0b0d;
      padding: 120px 6vw 140px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .contact-section__inner { width: 100%; max-width: 580px; }
    .contact-section__kicker {
      display: block;
      font-family: 'Space Mono', monospace;
      font-size: 12px;
      letter-spacing: .28em;
      text-transform: uppercase;
      color: #4fa8ff;
      margin-bottom: 28px;
    }
    .contact-section h2 {
      margin: 0 0 48px;
      font-weight: 800;
      font-size: clamp(32px, 5vw, 64px);
      line-height: 1.0;
      letter-spacing: -.032em;
      color: #ecece4;
    }
    .form-field { margin-bottom: 24px; }
    .form-field label {
      display: block;
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: rgba(236,234,228,.55);
      margin-bottom: 8px;
    }
    .form-field input,
    .form-field textarea {
      width: 100%;
      background: #0c0e12;
      border: 1px solid rgba(236,234,228,.12);
      color: #ecece4;
      font-family: 'Archivo', system-ui, sans-serif;
      font-size: 15px;
      padding: 14px 16px;
      outline: none;
      border-radius: 0;
      -webkit-appearance: none;
      transition: border-color .2s;
    }
    .form-field input:focus,
    .form-field textarea:focus { border-color: rgba(79,168,255,.5); }
    .form-field input::placeholder,
    .form-field textarea::placeholder { color: rgba(236,234,228,.28); }
    .form-field textarea { resize: vertical; min-height: 120px; }
    .form-submit {
      all: unset;
      cursor: pointer;
      font-weight: 600;
      font-size: 15px;
      letter-spacing: .01em;
      color: #0a0b0d;
      background: #4fa8ff;
      padding: 15px 36px;
      box-shadow: 0 0 26px rgba(79,168,255,.35);
      transition: box-shadow .2s;
    }
    .form-submit:hover { box-shadow: 0 0 40px rgba(79,168,255,.55); }

    /* ── Site footer ─────────────────────────────────────────────── */
    .site-footer {
      border-top: 1px solid rgba(236,234,228,.08);
      padding: 28px 6vw;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    .site-footer__nav { display: flex; gap: 24px; }
    .site-footer__nav a {
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: rgba(236,234,228,.35);
      transition: color .2s;
    }
    .site-footer__nav a:hover { color: rgba(236,234,228,.75); }
    .site-footer__copy {
      font-family: 'Space Mono', monospace;
      font-size: 11px;
      letter-spacing: .1em;
      color: rgba(236,234,228,.22);
      margin: 0;
    }

    /* ── Cookie banner ───────────────────────────────────────────── */
    .cookie-banner {
      position: fixed;
      bottom: 24px;
      left: 24px;
      max-width: 420px;
      background: #0c0e12;
      border: 1px solid rgba(236,234,228,.12);
      padding: 18px 20px;
      z-index: 9999;
      display: flex;
      gap: 16px;
      align-items: center;
    }
    .cookie-banner p {
      margin: 0;
      flex: 1;
      font-size: 13px;
      line-height: 1.5;
      color: rgba(236,234,228,.6);
    }
    .cookie-banner a { color: #4fa8ff; }
    .cookie-banner__btn {
      all: unset;
      cursor: pointer;
      font-weight: 600;
      font-size: 13px;
      color: #4fa8ff;
      white-space: nowrap;
    }
  </style>
</head>
<body>

  <main>
    {{ content | safe }}
  </main>

  <!-- ── Netlify contact form (bereikbaar via "Neem contact op") ── -->
  <section id="contact-form" class="contact-section" aria-labelledby="contact-h2">
    <div class="contact-section__inner">
      <span class="contact-section__kicker">Contact</span>
      <h2 id="contact-h2">Vertel wat er speelt.</h2>
      <form
        name="contact"
        method="POST"
        action="/dank-je.html"
        data-netlify="true"
        netlify-honeypot="bot-field"
        aria-label="Contactformulier"
      >
        <p hidden><label>Niet invullen: <input name="bot-field"></label></p>
        <div class="form-field">
          <label for="naam">Naam</label>
          <input type="text" id="naam" name="naam" autocomplete="name" placeholder="Sam Altman" required>
        </div>
        <div class="form-field">
          <label for="email">E-mailadres</label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="sam@altman.nl" required>
        </div>
        <div class="form-field">
          <label for="bericht">Bericht</label>
          <textarea id="bericht" name="bericht" rows="5" placeholder="Vertel kort wat je nodig hebt." required></textarea>
        </div>
        <button type="submit" class="form-submit">Versturen</button>
      </form>
    </div>
  </section>

  <footer class="site-footer" role="contentinfo">
    <nav class="site-footer__nav" aria-label="Footer navigatie">
      <a href="/privacy.html">Privacy</a>
    </nav>
    <p class="site-footer__copy">&copy; <span id="current-year">2026</span> BYGGR &mdash; Remco Baumeister, Delden</p>
  </footer>

  <div id="cookie-banner" class="cookie-banner" role="alertdialog" aria-label="Cookiemelding" hidden>
    <p>Deze site gebruikt analytics. <a href="/privacy.html">Meer info</a></p>
    <button id="cookie-accept" class="cookie-banner__btn">Akkoord</button>
  </div>

  {% if includeNetlifyIdentity %}
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on('init', function(user) {
        if (!user) {
          window.netlifyIdentity.on('login', function() { document.location.href = '/admin/'; });
        }
      });
    }
  </script>
  {% endif %}

  <script src="/src/js/byggr-canvas.js" defer></script>
  <script>
    document.getElementById('current-year').textContent = new Date().getFullYear();
    (function () {
      function loadGA() {
        if (window._gaLoaded) return;
        window._gaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-KTDQMECGQJ';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-KTDQMECGQJ');
      }
      var banner = document.getElementById('cookie-banner');
      var btn = document.getElementById('cookie-accept');
      if (localStorage.getItem('byggr-cookies')) {
        loadGA();
      } else {
        if (banner) banner.style.display = 'flex';
      }
      if (btn) btn.addEventListener('click', function () {
        localStorage.setItem('byggr-cookies', '1');
        if (banner) banner.style.display = 'none';
        loadGA();
      });
    })();
  </script>

</body>
</html>
