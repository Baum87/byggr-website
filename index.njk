                  style="all:unset; cursor:pointer; font-weight:600; font-size:15px; letter-spacing:.01em; color:#ecece4; background:transparent; border:1px solid rgba(236,234,228,.28); padding:15px 30px;">
            Neem contact op
          </button>
        </div>
        <div style="margin-top:60px; font-family:'Space Mono',monospace; font-size:11.5px; letter-spacing:.2em; text-transform:uppercase; color:rgba(236,234,228,.38);">
          Byggr &middot; Delden &middot; hello@byggr.nl
        </div>
      </div>

    </div><!-- /overlays -->
  </div><!-- /stage -->
</div><!-- /container -->

<script>
(function () {
  var track    = document.getElementById('byg-car-track');
  var car      = document.getElementById('byg-car');
  var dotsWrap = document.getElementById('byg-car-dots');
  var btnPrev  = document.getElementById('byg-car-prev');
  var btnNext  = document.getElementById('byg-car-next');
  if (!track || !car || !dotsWrap) return;

  var slides = track.querySelectorAll('.byg-car-slide');
  var total  = slides.length;
  var cur    = 0;
  var timer;

  // Generate dots from slide count — no hardcoding in HTML
  var dots = [];
  for (var i = 0; i < total; i++) {
    var dot = document.createElement('button');
    dot.setAttribute('aria-label', 'Slide ' + (i + 1));
    dot.style.cssText = 'width:6px;height:6px;border-radius:50%;border:none;padding:0;cursor:pointer;transition:background .2s,transform .2s;';
    dotsWrap.appendChild(dot);
    dots.push(dot);
  }

  // Hover states via JS listeners — no inline onmouseover
  [btnPrev, btnNext].forEach(function (btn) {
    btn.addEventListener('mouseenter', function () {
      btn.style.borderColor = 'rgba(79,168,255,.5)';
      btn.style.color = '#4fa8ff';
    });
    btn.addEventListener('mouseleave', function () {
      btn.style.borderColor = 'rgba(236,234,228,.18)';
      btn.style.color = 'rgba(236,234,228,.6)';
    });
  });

  function goTo(n) {
    cur = (n + total) % total;
    // Use scrollWidth of track divided by total slides — no hardcoded gap
    var slideW = track.scrollWidth / total;
    track.style.transform = 'translateX(-' + (cur * slideW) + 'px)';
    dots.forEach(function (d, i) {
      d.style.background = i === cur ? '#4fa8ff' : 'rgba(236,234,228,.28)';
      d.style.transform  = i === cur ? 'scale(1.35)' : 'scale(1)';
    });
  }

  btnPrev.addEventListener('click', function () { clearInterval(timer); goTo(cur - 1); startAuto(); });
  btnNext.addEventListener('click', function () { clearInterval(timer); goTo(cur + 1); startAuto(); });
  dots.forEach(function (d, i) { d.addEventListener('click', function () { clearInterval(timer); goTo(i); startAuto(); }); });

  function startAuto() { timer = setInterval(function () { goTo(cur + 1); }, 5000); }
  car.addEventListener('mouseenter', function () { clearInterval(timer); });
  car.addEventListener('mouseleave', startAuto);

  goTo(0);
  startAuto();
})();
</script>
